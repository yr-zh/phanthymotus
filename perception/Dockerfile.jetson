# ── Jetson Gentleman TTS (Matcha + BigVGAN Python ORT) ───────────
# Base from company TCR (JP5.1.1 or JP6.1):
#   bj-warehouse.tencentcloudcr.com/phanthy-motus/jetson-base:jp${JP_VERSION}-torch
#
#   docker build -f perception/Dockerfile.jetson --build-arg JP_VERSION=511 \
#     -t phanthymotus-perception-tts:jp511 .
#   docker build -f perception/Dockerfile.jetson --build-arg JP_VERSION=61 \
#     -t phanthymotus-perception-tts:jp61 .
#
# Runtime is Gentleman-only: jieba/pypinyin + onnxruntime-gpu CUDA EP.
# No sherpa-onnx, Melo, Piper, TensorRT, g2p-en, nltk, wetext, scipy.
# ────────────────────────────────────────────────────────────────────

ARG PYPI_MIRROR=https://pypi.tuna.tsinghua.edu.cn/simple/
ARG APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
ARG JP_VERSION=61
FROM bj-warehouse.tencentcloudcr.com/phanthy-motus/jetson-base:jp${JP_VERSION}-torch
ARG PYPI_MIRROR APT_MIRROR JP_VERSION
ARG SKIP_VOP_DEPS=ON
ARG JUICEFS_TTS=http://172.28.4.81:34567/fanyi/phanthymotus_tts

ENV PIP_INDEX_URL=${PYPI_MIRROR} \
    PIP_EXTRA_INDEX_URL= \
    PIP_TRUSTED_HOST="mirrors.tuna.tsinghua.edu.cn pypi.tuna.tsinghua.edu.cn pypi.org files.pythonhosted.org"

RUN if [ -n "${APT_MIRROR}" ]; then \
        sed -i "s/archive.ubuntu.com/${APT_MIRROR}/g; s/ports.ubuntu.com/${APT_MIRROR}/g" /etc/apt/sources.list; \
    fi

RUN if ls /etc/apt/sources.list.d/*.list 1>/dev/null 2>&1; then \
        sed -i 's|http://packages.ros.org/ros2/ubuntu|https://mirrors.tuna.tsinghua.edu.cn/ros2/ubuntu|g' /etc/apt/sources.list.d/*.list && \
        sed -i 's|deb \[|deb [trusted=yes |g; s|deb http|deb [trusted=yes] http|g' /etc/apt/sources.list.d/ros2*.list; \
    fi

# cmake/g++/python3-dev: only to colcon-build audio_msgs, then purged.
RUN rm -f /etc/apt/sources.list.d/* && rm -rf /var/cache/apt/archives/* /var/lib/apt/lists/* && \
    apt-get -o Acquire::AllowInsecureRepositories=true update && \
    apt-get install -y --no-install-recommends --allow-unauthenticated \
        cmake g++ python3-dev wget ca-certificates && \
    apt-get clean && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

RUN pip3 install --no-cache-dir -i ${PYPI_MIRROR} colcon-common-extensions && \
    pip3 install --no-cache-dir -i ${PYPI_MIRROR} "empy<4"

COPY deploy/ros-base/audio_msgs/ /ros_ws/src/audio_msgs/
RUN cd /ros_ws && \
    . /opt/ros/humble/install/setup.bash && \
    colcon build --packages-select audio_msgs --cmake-args -DCMAKE_BUILD_TYPE=Release && \
    apt-get -o Acquire::AllowInsecureRepositories=true update && \
    apt-get purge -y --auto-remove cmake g++ python3-dev && \
    apt-get clean && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* /root/.cache

# Gentleman PhoneTone + ROS MCP. --ignore-installed: JP5 base PyYAML is distutils.
# No webrtcvad/dashscope: ASR is disabled and those would need gcc after we purge it.
RUN pip3 install --no-cache-dir -i ${PYPI_MIRROR} \
    --ignore-installed pyyaml websockets psutil \
    kaldifst jieba pypinyin unidecode sentencepiece

# Bake onnxruntime-gpu into the image (do not pip-install at container start).
# JP5.1.1 = cp38 / ORT 1.16.3; JP6.1 = cp310 / ORT 1.23.0.
RUN set -eux; \
    case "${JP_VERSION}" in \
      511) ORT_WHL="onnxruntime_gpu-1.16.3-cp38-cp38-linux_aarch64.whl" ;; \
      61)  ORT_WHL="onnxruntime_gpu-1.23.0-cp310-cp310-linux_aarch64.whl" ;; \
      *) echo "unsupported JP_VERSION=${JP_VERSION}"; exit 1 ;; \
    esac; \
    python3 -c "import urllib.request, sys; urllib.request.urlretrieve(sys.argv[1], sys.argv[2])" \
      "${JUICEFS_TTS}/${ORT_WHL}" "/tmp/${ORT_WHL}"; \
    pip3 install --no-cache-dir "/tmp/${ORT_WHL}"; \
    rm -f "/tmp/${ORT_WHL}"; \
    python3 -c "import onnxruntime as ort; assert 'CUDAExecutionProvider' in ort.get_available_providers(), ort.get_available_providers(); print('onnxruntime', ort.__version__, ort.get_available_providers())"

# CUDA math libs (cublas/cublasLt/cufft/cudart) required by ORT CUDA/TRT EPs.
# jetson-base strips them; the pack mirrors /usr/local/cuda-12.6 from the JP6 BSP.
RUN set -eux; \
    if [ "${JP_VERSION}" = "61" ]; then \
        python3 -c "import urllib.request, sys; urllib.request.urlretrieve(sys.argv[1], sys.argv[2])" \
          "${JUICEFS_TTS}/cuda12-ort-libs-jp6.tar.bz2" "/tmp/cuda-libs.tar.bz2"; \
        mkdir -p /opt/cuda12-libs; \
        tar -xjf /tmp/cuda-libs.tar.bz2 -C /opt/cuda12-libs --strip-components=1; \
        rm -f /tmp/cuda-libs.tar.bz2; \
    fi
# CUDA math libs dir must stay in LD_LIBRARY_PATH (see the final ENV below).

WORKDIR /work
COPY perception/main.py /work/main.py
COPY perception/plugins/ /work/plugins/
COPY perception/utils/ /work/utils/
COPY perception/config.yaml /work/config.yaml
COPY perception/deploy/entrypoint.sh /deploy/entrypoint.sh
COPY deploy/judgeflow_tts_run.sh /deploy/judgeflow_tts_run.sh
RUN chmod 755 /deploy/entrypoint.sh /deploy/judgeflow_tts_run.sh && \
    rm -f /work/utils/matcha_trt.py /work/utils/vocos_trt.py && \
    find /work /deploy -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true

EXPOSE 15720
EXPOSE 15721

ENV NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility
LABEL com.nvidia.volumes.needed="nvidia_driver"

RUN SITE=$(python3 -c "import site; print(site.getsitepackages()[0])") && \
    find /ros_ws/install -name "site-packages" -type d > "${SITE}/ros_ws.pth" && \
    (find /opt/ros/humble/install -name "site-packages" -type d >> "${SITE}/ros_ws.pth" 2>/dev/null || true)

ENV LD_LIBRARY_PATH="/opt/cuda12-libs:/usr/lib/aarch64-linux-gnu/nvidia:/usr/lib/aarch64-linux-gnu:/usr/local/cuda/lib64:/ros_ws/install/audio_msgs/lib:/opt/ros/humble/install/lib:${LD_LIBRARY_PATH}"
ENV AMENT_PREFIX_PATH="/ros_ws/install/audio_msgs:/opt/ros/humble/install"

ENTRYPOINT ["/deploy/entrypoint.sh"]
